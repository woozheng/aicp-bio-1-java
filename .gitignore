# ============================================================
# AICP-BIO-1 · Java
# ============================================================

# ---------- 构建产物 ----------
target/
dependency-reduced-pom.xml
*.class

# ---------- 配置（含密钥，别提交） ----------
aicp.yaml

# ---------- 数据与记忆 ----------
data/

# ---------- 插件运行时产物 ----------
# 插件编译出的 .class（由 .java 动态编译）
src/plugins/**/*.class

# 插件自动下载的依赖 jar（由 @DEPS 运行时拉取）
src/plugins/libs/

# ---------- 生成的应用（全是产物，不进仓库） ----------
src/plugins/applications/

# ---------- 前端：只保留 www 根目录的入口文件 ----------
www/*
!www/*.html
!www/*.js
!www/*.css

# ---------- 日志与临时文件 ----------
*.log
logs/
*.tmp
*.bak
*.swp

# ---------- IDE ----------
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# ---------- OS ----------
.DS_Store
Thumbs.db
# ---------- 契约缓存（由 contract_agent 运行时生成） ----------
*.contract.json
